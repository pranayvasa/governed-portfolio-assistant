# Copy to .env for local runs. Never commit .env.
# Use a key from a project funded by prepaid credits with auto-reload OFF,
# so the prepaid balance caps spending (or a free-tier project with no billing).
GEMINI_API_KEY=
# Signs the per-session question counter. Any long random string; set it in
# Vercel's environment variables too. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
